# Copy this file to .env and fill in real values. .env is gitignored (NFR-01).
# Gemini is the ONLY model provider (ref-doc.md §3.4). Do not add other providers.

# --- Required: Google Gemini API key (from https://aistudio.google.com/apikey) ---
# A valid AI Studio key starts with "AIza".
GOOGLE_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# --- Model selection (optional; safe defaults applied in src/config.py) ---
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_JUDGE_MODEL=gemini-3.5-flash

# --- Filesystem locations (optional) ---
LOG_DIR=logs
STATE_DIR=data/state

# --- Resilience / graph limits (optional; NFR-04) ---
REQUEST_TIMEOUT_S=30
MAX_RETRIES=3
RECURSION_LIMIT=25
MAX_STEPS=12

# --- Observability (used from Phase 3; optional) ---
PHOENIX_ENABLED=true
PHOENIX_PROJECT=bank-copilot
